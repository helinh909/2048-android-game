<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:layout_editor_absoluteX="1dp"
    tools:layout_editor_absoluteY="1dp"
    tools:context=".Game2048">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="vertical"
        tools:context=".Game2048">

        <TextView
            android:id="@+id/tuto2Title"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="50dp"
            android:layout_marginRight="30dp"
            android:text="@string/tuto2Title"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tuto1txt"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="@string/tutorial_2"
            android:textAlignment="center"
            android:textSize="17sp" />

    </LinearLayout>

    <GridLayout
        android:id="@+id/gameGrid"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="20dp"
        android:columnCount="4"
        android:rowCount="4"
        android:padding="20dp"
        android:background="@drawable/border">

        <TextView
            android:id="@+id/tiles1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:textSize="20sp" />

    </GridLayout>

    <ImageView
        android:id="@+id/leftArrowAnimation"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:src="@drawable/leftarrow"
        android:layout_marginLeft="132dp"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="125dp"
        android:orientation="horizontal"
        >

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/tileAnimationMerge1"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/tile2"
                />

            <ImageView
                android:id="@+id/tileAnimationMerged"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/tile4"
                android:visibility="invisible"/>

        </RelativeLayout>

        <ImageView
            android:id="@+id/tileAnimationMerge2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/tile2"
            android:layout_marginLeft="50dp"/>


    </LinearLayout>

</LinearLayout>



